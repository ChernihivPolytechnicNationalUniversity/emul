{
  "name": "emul",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "api": "pnpm --filter emul-api dev",
    "worker": "pnpm --filter emul-worker dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:sim": "vitest run --project sim",
    "test:watch": "vitest",
    "preview": "vite preview",
    "bench": "tsx --tsconfig tsconfig.app.json scripts/bench.ts",
    "field-bench": "tsx --tsconfig tsconfig.app.json scripts/field-bench.ts",
    "geom-bench": "tsx --tsconfig tsconfig.app.json scripts/geom-bench.ts",
    "mcu-jit": "tsx --tsconfig tsconfig.app.json scripts/mcu-jit.ts",
    "symbols": "tsx --tsconfig tsconfig.app.json scripts/symbols.ts",
    "firmware": "make -C firmware all expect && make -C firmware/hal"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "emul-shared": "workspace:*",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11"
  }
}
