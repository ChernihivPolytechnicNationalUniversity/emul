node_modules
dist
dist-ssr
*.tsbuildinfo

# Firmware sources and their compiled tests; the example ELFs in public/firmware are copied
firmware

# Deploy-time settings are written by the Dockerfile (APP_VERSION) or mounted at run time
public/config.json

