# Only sources needed for `pnpm build` go to the daemon; everything else is rebuilt or mounted
node_modules
dist
dist-ssr
*.tsbuildinfo

# Firmware builds and archives; the sources are bundled as the examples' projects
firmware/**/build
firmware/**/*.elf
firmware/**/*.bin
firmware/**/*.o
firmware/**/*.7z

# Deploy-time settings are mounted at /etc/config/config.json at run time
public/config.json

# Repo metadata, logs, editor files
.git
.gitignore
.dockerignore
Dockerfile
logs
*.log
*.local
.env
.env.*
.vscode
.idea
.DS_Store
*.md

# Generated in the image build from the staged ST sources
public/symbols
