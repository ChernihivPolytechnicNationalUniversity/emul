# Dependencies and build output
node_modules
dist
dist-ssr
*.tsbuildinfo

# Compiled test firmware (`make -C firmware`); the examples ship sources, built by the service
firmware/build
firmware/*/build

# Deploy-time settings; copy config.example.json here for local dev, the image writes its own
public/config.json

# Logs
logs
*.log

# Local overrides
*.local
.env
.env.*
!.env.example

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The editor's HAL/CMSIS symbol index, generated at build time (`pnpm symbols`)
public/symbols
# The debugger's ST sources and peripheral register maps, generated at build time (`pnpm st-sources`, `pnpm peripherals`)
public/st
public/peripherals
